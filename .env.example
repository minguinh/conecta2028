# Private server variables: copy to .env.local; never commit real values.
# Neon pooled connection with TLS (runtime).
DATABASE_URL=
# Neon direct connection with TLS (migrations).
DATABASE_URL_UNPOOLED=
# Generate at least 32 random bytes. Keep stable in production.
BETTER_AUTH_SECRET=
# Match browser origin. Production must use your public HTTPS URL.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Optional: public MapLibre style URL from your tile provider (no secret credentials).
NEXT_PUBLIC_MAP_STYLE_URL=
# Local-only first administrator setup. Blocked in production and after first user.
ALLOW_LOCAL_ADMIN_SETUP=false
