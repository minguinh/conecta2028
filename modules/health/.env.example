# Serviço independente. Nunca reutilizar banco, chaves ou cookies do painel.
HEALTH_DATABASE_URL=
# Somente migrations locais; NÃO enviar ao Worker.
HEALTH_DATABASE_URL_UNPOOLED=
# Papel exclusivo health_retention_service para limpeza programada.
HEALTH_RETENTION_DATABASE_URL=
# AES-GCM: 32 bytes aleatórios em base64. Manter backup privado da chave.
HEALTH_DATA_KEY=
# Better Auth próprio: mínimo de 32 bytes aleatórios.
HEALTH_AUTH_SECRET=
HEALTH_URL=http://localhost:8788
HEALTH_ENABLED=false
# Aprovação do responsável. Prazo aprovado: seis anos calendários.
HEALTH_POLICY_APPROVED_AT=
