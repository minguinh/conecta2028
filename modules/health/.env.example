# Independent service only. Never reuse the primary app's database, token or bucket.
HEALTH_DATABASE_URL=
HEALTH_DATABASE_URL_UNPOOLED=
HEALTH_ENABLED=false
# Configure verified identity provider + audience and independent server memberships.
HEALTH_IDENTITY_ISSUER=
HEALTH_IDENTITY_AUDIENCE=
# No default legal basis or retention period. Require approved, versioned policy.
HEALTH_POLICY_VERSION=
HEALTH_RETENTION_DAYS=
HEALTH_AUDIT_RETENTION_DAYS=
HEALTH_BACKUP_RETENTION_DAYS=
# HEALTH_DOCUMENTS is a private R2 Worker binding, never a public URL.
